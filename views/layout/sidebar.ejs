<!-- SIDEBAR -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon"><i class="bi bi-tools"></i></div>
    <h6>ระบบแจ้งงาน</h6>
    <small>Task Management v1.0</small>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-label">หลัก</div>
    <a class="nav-item <%= page === 'index' ? 'active' : '' %>" href="/index"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
    <a class="nav-item <%= page === 'form' ? 'active' : '' %>" href="/form"><i class="bi bi-plus-circle-fill"></i><span>แจ้งงาน</span></a>
    <a class="nav-item <%= page === 'timeline' ? 'active' : '' %>" href="/timeline"><i class="bi bi-search"></i><span>ติดตามงาน</span></a>
    <a class="nav-item <%= page === 'history' ? 'active' : '' %>" href="/history"><i class="bi bi-clock-history"></i><span>ประวัติงาน</span></a>

    <div class="nav-label">เจ้าหน้าที่</div>
    <a class="nav-item" onclick="setActive(this);window.location.href='/manage'"><i class="bi bi-kanban"></i><span>จัดการงาน</span><span class="nav-badge red">5</span></a>
    <a class="nav-item" onclick="setActive(this);window.location.href='/queue'"><i class="bi bi-diagram-3"></i><span>มอบหมายงาน</span><span class="nav-badge" id="nav-pending-count">0</span></a>
    <a class="nav-item" onclick="setActive(this)">
      <i class="bi bi-list-ol"></i><span>คิวงาน</span>
      <span class="nav-badge">12</span>
    </a>
    <a class="nav-item" onclick="setActive(this)">
      <i class="bi bi-chat-dots"></i><span>แชท</span>
    </a>

    <% if(user.role == 1){ %>
    <div class="nav-label">Admin</div>
    <a class="nav-item <%= page === 'report' ? 'active' : '' %>" href="/report">
      <i class="bi bi-bar-chart-line"></i><span>รายงาน</span>
    </a>
    <a class="nav-item <%= page === 'users' ? 'active' : '' %>" href="/users">
      <i class="bi bi-people"></i><span>ผู้ใช้งาน</span>
    </a>
    <a class="nav-item" onclick="setActive(this)">
      <i class="bi bi-gear"></i><span>ตั้งค่า</span>
    </a>
    <% } %>
  </nav>

  <!-- USER + LOGOUT ในแถวเดียวกัน -->
  <div class="sidebar-user">
    <div class="user-avatar" id="user-avatar">--</div>
    <div class="user-info">
      <span class="user-name" id="user-fullname">กำลังโหลด...</span>
      <small class="user-role" id="user-role">--</small>
    </div>
    <!--
    <button class="btn-logout-icon" title="ออกจากระบบ"
      onclick="if(confirm('ออกจากระบบ?')){ window.location.href='/logout'; }">
      <i class="bi bi-box-arrow-right"></i>
    </button>
    -->
    <button class="btn-logout-icon" title="ออกจากระบบ" onclick="logoutConfirm()">
      <i class="bi bi-box-arrow-right"></i>
    </button>
  </div>
</aside>

<script>
function logoutConfirm() {

  Swal.fire({
    title: 'ออกจากระบบ?',
    text: 'คุณต้องการออกจากระบบใช่หรือไม่',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'ออกจากระบบ',
    cancelButtonText: 'ยกเลิก',
    reverseButtons: true,
    confirmButtonColor: '#ef4444',
    cancelButtonColor: '#6b7280'
  }).then((result) => {

    if (result.isConfirmed) {
      window.location.href = '/logout';
    }
  });

}
</script>