<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>จัดการงาน - ระบบแจ้งงาน</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/sidebar.css">
<link rel="stylesheet" href="/css/manage.css">
</head>
<body>

<!-- SIDEBAR -->
<%- include('../partials/sidebar', { page: 'manage' }) %>

<!-- MAIN -->
<div class="main">
  <div class="topbar">
    <div>
      <div class="topbar-title">จัดการงาน</div>
      <div class="topbar-sub" id="topbar-sub">กำลังโหลด...</div>
    </div>
    <div class="topbar-actions">
  <button class="icon-btn" title="รีเฟรช" onclick="loadTickets()">
    <i class="bi bi-arrow-clockwise" style="font-size:16px"></i>
  </button>
  <button class="btn-primary-sm" onclick="window.location.href='/form'">
    <i class="bi bi-plus-lg"></i> แจ้งงานใหม่
  </button>
  <div style="position:relative" id="noti-wrap">
    <button class="noti-btn" onclick="toggleNotification()">
      <i class="bi bi-bell"></i>
      <span class="noti-dot" id="noti-dot" style="display:none"></span>
    </button>
    <div class="noti-dropdown" id="noti-dropdown" style="display:none">
      <div class="noti-head">
        <span>การแจ้งเตือน</span>
        <button class="noti-readall" onclick="markAllRead()">อ่านทั้งหมด</button>
      </div>
      <div id="noti-list"></div>
      <div class="noti-foot">
        <button>ดูทั้งหมด</button>
      </div>
    </div>
  </div>
</div>
  </div>

  <div class="content">
    <!-- [FIX] stat-strip เป็น div เปล่า ให้ JS renderStats() ใส่เนื้อหา -->
    <div class="stat-strip" id="stat-strip"></div>

    <div class="controls-row">
      <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" id="search-input" placeholder="ค้นหา Ticket, ชื่องาน..." oninput="filterCards()">
      </div>
      <select class="filter-select" id="filter-priority" onchange="filterCards()">
        <option value="">ทุกความเร่งด่วน</option>
        <option value="high">ด่วนมาก</option>
        <option value="med">ปานกลาง</option>
        <option value="low">ปกติ</option>
      </select>
      <button class="btn-ghost-sm" onclick="clearFilters()"><i class="bi bi-x-lg"></i> ล้างตัวกรอง</button>
    </div>

    <div class="queue-cols">
      <div class="qcol col-pending">
        <div class="qcol-header">
          <div class="qcol-title"><i class="bi bi-hourglass-split" style="color:var(--pending)"></i>รอดำเนินการ</div>
          <span class="qcol-count" id="cnt-pending">0</span>
        </div>
        <div class="qcol-body" id="col-pending"><div class="empty-state"><i class="bi bi-inbox"></i>กำลังโหลด...</div></div>
      </div>
      <div class="qcol col-inprogress">
        <div class="qcol-header">
          <div class="qcol-title"><i class="bi bi-gear-wide-connected" style="color:var(--inprogress)"></i>กำลังดำเนินการ</div>
          <span class="qcol-count" id="cnt-inprogress">0</span>
        </div>
        <div class="qcol-body" id="col-inprogress"><div class="empty-state"><i class="bi bi-inbox"></i>กำลังโหลด...</div></div>
      </div>
      <div class="qcol col-done">
        <div class="qcol-header">
          <div class="qcol-title"><i class="bi bi-check-circle-fill" style="color:var(--done)"></i>เสร็จสิ้น</div>
          <span class="qcol-count" id="cnt-done">0</span>
        </div>
        <div class="qcol-body" id="col-done"><div class="empty-state"><i class="bi bi-inbox"></i>กำลังโหลด...</div></div>
      </div>
    </div>
  </div>
</div>

<!-- DETAIL POPUP -->
<div class="panel-backdrop" id="backdrop" onclick="closePanel()">
  <div class="detail-panel" id="detail-panel" onclick="event.stopPropagation()">
    <div class="panel-header">
      <div>
        <div style="font-size:15px;font-weight:700;margin-bottom:2px" id="panel-id"></div>
        <div id="panel-status-badge"></div>
      </div>
      <button class="panel-close" onclick="closePanel()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="panel-body" id="panel-body"></div>
  </div>
</div>


<!-- CANCEL CONFIRM MODAL -->
<div class="modal-overlay" id="cancel-modal">
  <div class="modal-box" style="width:400px">
    <div class="modal-header">
      <h6><i class="bi bi-exclamation-triangle-fill" style="color:var(--rejected);margin-right:6px"></i>ยืนยันการยกเลิกงาน</h6>
      <button class="panel-close" onclick="closeCancelModal()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:12px">คุณต้องการยกเลิกงานนี้ใช่หรือไม่?</p>
      <div style="background:var(--body-bg);border-radius:var(--radius-sm);padding:10px 14px;font-size:13px">
        <div style="font-weight:600" id="cancel-task-title">—</div>
        <div style="color:var(--text-muted);font-size:11px;margin-top:3px" id="cancel-task-id">—</div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-ghost-sm" onclick="closeCancelModal()">ไม่ยกเลิก</button>
      <button class="btn-danger-sm" onclick="confirmCancel()"><i class="bi bi-x-lg"></i> ยืนยันยกเลิก</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast-wrap" id="toast-wrap"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/manage.js"></script>
</body>
</html>