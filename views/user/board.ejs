<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ระบบแจ้งงาน - Dashboard</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/sidebar.css">
<link rel="stylesheet" href="/css/board.css">
</head>
<body>

<%- include('../partials/sidebar', { page: 'index' }) %>

<div class="main">

  <!-- TOPBAR -->
  <div class="topbar">
    <div>
      <div class="topbar-title">Dashboard ภาพรวม</div>
      <div class="topbar-sub" id="topbar-date">—</div>
    </div>
    <div class="topbar-actions">
      <div class="tab-nav">
        <button class="tab-btn active">วันนี้</button>
        <button class="tab-btn" onclick="switchTab(this)">สัปดาห์</button>
        <button class="tab-btn" onclick="switchTab(this)">เดือน</button>
      </div>
      <button class="icon-btn" title="ดาวน์โหลดรายงาน">
        <i class="bi bi-download" style="font-size:16px"></i>
      </button>
      <button class="btn-primary-sm" onclick="window.location='/form'">
        <i class="bi bi-plus-lg"></i> แจ้งงานใหม่
      </button>
      <div style="position:relative" id="noti-wrap">
        <button class="noti-btn" onclick="Noti.toggle()" aria-label="การแจ้งเตือน">
          <i class="bi bi-bell"></i>
          <span class="noti-dot" id="noti-dot" style="display:none"></span>
        </button>
        <div class="noti-dropdown" id="noti-dropdown" style="display:none">
          <div class="noti-head">
            <span>การแจ้งเตือน</span>
            <button class="noti-readall" onclick="Noti.markAllRead()">อ่านทั้งหมด</button>
          </div>
          <div id="noti-list"></div>
          <div class="noti-foot">
            <button onclick="window.location.href='/timeline'">ดูทั้งหมด</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="content">

    <!-- STAT CARDS -->
    <div class="stat-cards">
      <div class="stat-card sc-pending">
        <div class="sc-icon"><i class="bi bi-hourglass-split"></i></div>
        <div class="sc-num" id="num-pending">—</div>
        <div class="sc-label">รอดำเนินการ</div>
        <div class="sc-trend up"><i class="bi bi-arrow-up-short"></i> กำลังโหลด...</div>
      </div>
      <div class="stat-card sc-inprogress">
        <div class="sc-icon"><i class="bi bi-gear-wide-connected"></i></div>
        <div class="sc-num" id="num-inprogress">—</div>
        <div class="sc-label">กำลังดำเนินการ</div>
        <div class="sc-trend up"><i class="bi bi-arrow-up-short"></i> กำลังโหลด...</div>
      </div>
      <div class="stat-card sc-done">
        <div class="sc-icon"><i class="bi bi-check-circle-fill"></i></div>
        <div class="sc-num" id="num-done">—</div>
        <div class="sc-label">เสร็จสิ้นแล้ว</div>
        <div class="sc-trend up"><i class="bi bi-arrow-up-short"></i> กำลังโหลด...</div>
      </div>
    </div>

    <!-- ROW 1 -->
    <div class="grid-2">
      <!-- TASK LIST -->
      <div class="card-box">
        <div class="card-header">
          <h6><i class="bi bi-list-task" style="color:var(--primary);margin-right:6px"></i>งานล่าสุด</h6>
          <a href="/history" class="card-link">ดูทั้งหมด →</a>
        </div>
        <table class="task-table">
          <thead>
            <tr>
              <th>Ticket</th>
              <th>รายละเอียด</th>
              <th>สถานะ</th>
              <th>ความเร่งด่วน</th>
              <th>ผู้รับงาน</th>
              <th>วันที่</th>
            </tr>
          </thead>
          <tbody id="task-tbody">
            <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:20px;font-size:13px">กำลังโหลด...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- SIDEBAR CARDS -->
      <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- QUEUE -->
        <div class="card-box">
          <div class="card-header">
            <h6><i class="bi bi-list-ol" style="color:var(--primary);margin-right:6px"></i>คิวงานรอดำเนินการ</h6>
            <span style="font-size:11px;background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:99px;font-weight:600;" id="queue-count">—</span>
          </div>
          <div class="card-body-pad" id="queue-list">
            <div style="font-size:13px;color:var(--text-muted);padding:8px 0">กำลังโหลด...</div>
          </div>
        </div>

        <!-- NOTIFICATIONS -->
        <div class="card-box">
          <div class="card-header">
            <h6><i class="bi bi-bell-fill" style="color:var(--primary);margin-right:6px"></i>แจ้งเตือนล่าสุด</h6>
            <a href="/timeline" class="card-link">ทั้งหมด</a>
          </div>
          <div class="card-body-pad" id="recent-noti-list">
            <div style="font-size:13px;color:var(--text-muted);padding:8px 0">กำลังโหลด...</div>
          </div>
        </div>

      </div>
    </div>

    <!-- ROW 2 -->
    <div class="grid-2">

      <!-- BAR CHART -->
      <div class="card-box">
        <div class="card-header">
          <h6><i class="bi bi-bar-chart-line-fill" style="color:var(--primary);margin-right:6px"></i>งานรายวัน (สัปดาห์นี้)</h6>
        </div>
        <div class="card-body-pad">
          <div class="bar-chart" id="bar-chart"></div>
          <div style="display:flex;gap:16px;margin-top:12px;font-size:11px;">
            <span style="display:flex;align-items:center;gap:5px;color:var(--text-muted)">
              <span style="width:10px;height:10px;border-radius:3px;background:#BFDBFE;display:inline-block"></span>เข้าใหม่
            </span>
            <span style="display:flex;align-items:center;gap:5px;color:var(--text-muted)">
              <span style="width:10px;height:10px;border-radius:3px;background:#2563EB;display:inline-block"></span>เสร็จ
            </span>
          </div>
        </div>
      </div>

      <!-- TIMELINE (dynamic) -->
      <div class="card-box">
        <div class="card-header">
          <h6><i class="bi bi-activity" style="color:var(--primary);margin-right:6px"></i>ติดตาม <span id="tl-ticket-id">—</span></h6>
          <span class="badge-status inprogress">กำลังทำ</span>
        </div>
        <div class="card-body-pad">
          <div class="timeline" id="tl-body">
            <div style="font-size:13px;color:var(--text-muted)">กำลังโหลด...</div>
          </div>
          <div style="margin-top:8px;display:flex;gap:8px;">
            <button class="btn-ghost-sm" onclick="window.location.href='/timeline'"><i class="bi bi-chat-dots"></i> ติดตาม</button>
            <button class="btn-ghost-sm"><i class="bi bi-qr-code"></i> QR</button>
          </div>
        </div>
      </div>

    </div>

    <!-- ROW 3: SLA / STAFF -->
    <div class="grid-2">
      <div class="card-box">
        <div class="card-header">
          <h6><i class="bi bi-shield-check" style="color:var(--primary);margin-right:6px"></i>SLA ประจำเดือน</h6>
          <span style="font-size:12px;color:var(--text-muted)" id="sla-month-label">—</span>
        </div>
        <div class="card-body-pad">
          <div class="progress-wrap">
            <div class="progress-label">
              <span style="font-size:13px;font-weight:500">ไฟฟ้า / อาคาร</span>
              <span style="font-size:12px;font-weight:600;color:var(--done)">94%</span>
            </div>
            <div class="progress-bar-track"><div class="progress-bar-fill" style="width:94%;background:var(--done)"></div></div>
          </div>
          <div class="progress-wrap">
            <div class="progress-label">
              <span style="font-size:13px;font-weight:500">IT / คอมพิวเตอร์</span>
              <span style="font-size:12px;font-weight:600;color:var(--inprogress)">87%</span>
            </div>
            <div class="progress-bar-track"><div class="progress-bar-fill" style="width:87%;background:var(--inprogress)"></div></div>
          </div>
          <div class="progress-wrap">
            <div class="progress-label">
              <span style="font-size:13px;font-weight:500">ระบบน้ำ / ท่อ</span>
              <span style="font-size:12px;font-weight:600;color:var(--pending)">76%</span>
            </div>
            <div class="progress-bar-track"><div class="progress-bar-fill" style="width:76%;background:var(--pending)"></div></div>
          </div>
          <div class="progress-wrap">
            <div class="progress-label">
              <span style="font-size:13px;font-weight:500">เครือข่าย / Network</span>
              <span style="font-size:12px;font-weight:600;color:var(--done)">98%</span>
            </div>
            <div class="progress-bar-track"><div class="progress-bar-fill" style="width:98%;background:var(--done)"></div></div>
          </div>
        </div>
      </div>

      <div class="card-box">
        <div class="card-header">
          <h6><i class="bi bi-people-fill" style="color:var(--primary);margin-right:6px"></i>ประสิทธิภาพเจ้าหน้าที่</h6>
          <a href="#" class="card-link">ดูทั้งหมด</a>
        </div>
        <div class="card-body-pad">
          <table style="width:100%;font-size:13px;border-collapse:collapse;">
            <thead>
              <tr>
                <th style="text-align:left;padding:6px 0;font-size:11px;color:var(--text-muted);font-weight:600;border-bottom:1px solid var(--border)">ชื่อเจ้าหน้าที่</th>
                <th style="text-align:center;padding:6px 0;font-size:11px;color:var(--text-muted);font-weight:600;border-bottom:1px solid var(--border)">รับงาน</th>
                <th style="text-align:center;padding:6px 0;font-size:11px;color:var(--text-muted);font-weight:600;border-bottom:1px solid var(--border)">เสร็จ</th>
                <th style="text-align:right;padding:6px 0;font-size:11px;color:var(--text-muted);font-weight:600;border-bottom:1px solid var(--border)">อัตรา</th>
              </tr>
            </thead>
            <tbody id="staff-tbody">
              <tr><td colspan="4" style="text-align:center;color:var(--text-muted);padding:16px;font-size:13px">กำลังโหลด...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/noti.js"></script>
<script src="/js/board.js"></script>
<script>
  (function(){
    const now  = new Date();
    const days = ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'];
    const months = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน',
                    'กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
    const el = document.getElementById('topbar-date');
    if (el) el.textContent =
      `อัปเดตล่าสุด: วัน${days[now.getDay()]}ที่ ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()+543}`;

    const sla = document.getElementById('sla-month-label');
    if (sla) sla.textContent = months[now.getMonth()] + ' ' + (now.getFullYear()+543);
  })();
</script>
</body>
</html>