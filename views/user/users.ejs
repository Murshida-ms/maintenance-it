<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ระบบแจ้งงาน - Users Management</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="css/history.css">

</head>

<body>

<%- include('sidebar') %>

<div class="main">

  <!-- TOPBAR -->
  <div class="topbar">

    <div>
      <div class="topbar-title">
        ผู้ใช้งาน
      </div>

      <div class="topbar-sub">
        รายการผู้ใช้งานทั้งหมด
      </div>
    </div>

    <div class="topbar-actions">

      <button
        class="btn-primary-sm"
        data-bs-toggle="offcanvas"
        data-bs-target="#addUserCanvas">
        <i class="bi bi-person-add"></i>
        ผู้ใช้งานใหม่
      </button>

    </div>

  </div>

  <!-- CONTENT -->
  <div class="content">
    <div class="card-box">
      <div class="card-header">
        <h6>
          <i class="bi bi-people"></i>
          รายการผู้ใช้งาน
        </h6>
        <span id="result-count"></span>
      </div>
      <div style="overflow-x:auto">
        <table class="history-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Password</th>
              <th>ชื่อจริง</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>จัดการ</th>
            </tr>
          </thead>
          <tbody id="users-tbody"></tbody>
        </table>
      </div>
      <div
        id="empty-state"
        class="empty-state"
        style="display:none">
        ไม่พบข้อมูล
      </div>
    </div>
  </div>
</div>

<!-- ADD USER -->
<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="addUserCanvas"
     style="width:520px;">

  <div class="offcanvas-header border-bottom">

    <h5 class="offcanvas-title">

      <i class="bi bi-person-add"></i>
      เพิ่มผู้ใช้งาน

    </h5>

    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>

  </div>

  <div class="offcanvas-body p-3">

    <form id="addUserForm"
          class="needs-validation"
          novalidate>

      <div class="mb-3">

        <label class="form-label">
          Username
        </label>

        <input type="text"
               class="form-control"
               id="add-username"
               required>

        <div id="username-error"
             class="text-danger small mt-1"
             style="display:none">

          Username นี้ถูกใช้แล้ว

        </div>

      </div>

      <div class="mb-3">

        <label class="form-label">
          Password
        </label>

        <input type="password"
               class="form-control"
               id="add-password"
               required>

      </div>

      <div class="mb-3">

        <label class="form-label">
          ชื่อจริง
        </label>

        <input type="text"
               class="form-control"
               id="add-name"
               required>

      </div>

      <div class="mb-3">

        <label class="form-label">
          Email
        </label>

        <input type="email"
               class="form-control"
               id="add-email"
               required>

      </div>

      <div class="mb-3">

        <label class="form-label">
          สิทธิ์
        </label>

        <select class="form-select"
                id="add-role"
                required>

          <option value="">-</option>
          <option value="1">admin</option>
          <option value="2">manager</option>
          <option value="3">head</option>
          <option value="4">staff</option>
          <option value="5">guest</option>

        </select>

      </div>

      <div class="mb-4">

        <label class="form-label">
          สถานะ
        </label>

        <select class="form-select"
                id="add-status">

          <option value="active">
            Active
          </option>

          <option value="inactive">
            Inactive
          </option>

        </select>

      </div>

      <div class="d-grid">

        <button type="submit"
                class="btn btn-primary">

          <i class="bi bi-save"></i>
          บันทึก

        </button>

      </div>

    </form>

  </div>

</div>

<!-- EDIT USER -->
<div class="offcanvas offcanvas-end"
     tabindex="-1"
     id="editUserCanvas"
     style="width:520px;">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title">
      <i class="bi bi-pencil-square"></i>
      แก้ไขผู้ใช้งาน
    </h5>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="offcanvas">
    </button>
  </div>
  <div class="offcanvas-body p-3">
    <form id="editUserForm">
      <input type="hidden"
             id="edit-id">
      <div class="mb-3">
        <label class="form-label">
          Username
        </label>
        <input type="text"
               class="form-control"
               id="edit-username"
               required>
      </div>
      <div class="mb-3">
        <label class="form-label">
          Password
        </label>
        <input type="password"
               class="form-control"
               id="edit-password">
      </div>

      <div class="mb-3">

        <label class="form-label">
          ชื่อจริง
        </label>

        <input type="text"
               class="form-control"
               id="edit-name">

      </div>

      <div class="mb-3">

        <label class="form-label">
          Email
        </label>

        <input type="email"
               class="form-control"
               id="edit-email">

      </div>

      <div class="mb-3">

        <label class="form-label">
          สิทธิ์
        </label>

        <select class="form-select"
                id="edit-role">

          <option value="1">admin</option>
          <option value="2">manager</option>
          <option value="3">head</option>
          <option value="4">staff</option>
          <option value="5">guest</option>

        </select>

      </div>

      <div class="mb-4">

        <label class="form-label">
          สถานะ
        </label>

        <select class="form-select"
                id="edit-status">

          <option value="active">
            Active
          </option>

          <option value="inactive">
            Inactive
          </option>

        </select>

      </div>

      <div class="d-grid">

        <button type="submit"
                class="btn btn-warning">

          <i class="bi bi-save"></i>
          บันทึกการแก้ไข

        </button>

      </div>

    </form>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

let users = [];

const usernameInput =
  document.getElementById('add-username');

const usernameError =
  document.getElementById('username-error');

let usernameTimeout = null;

// LOAD USERS
async function loadUsers(){

  try{

    const res =
      await fetch('/api/getusers');

    users = await res.json();

    renderTable(users);

  }catch(err){

    console.error(err);
  }
}

// RENDER TABLE
function renderTable(data){

  const tbody =
    document.getElementById('users-tbody');

  if(!data.length){

    tbody.innerHTML = '';

    document.getElementById(
      'empty-state'
    ).style.display = 'block';

    return;
  }

  document.getElementById(
    'empty-state'
  ).style.display = 'none';

  tbody.innerHTML = data.map(user => `

    <tr>

      <td>${user.user_id}</td>

      <td>${user.username}</td>

      <td>

        <div class="d-flex align-items-center gap-2">

          <span id="pwd-${user.user_id}">
            ••••••••
          </span>

          <button
            type="button"
            class="btn btn-sm btn-light border"
            onclick="togglePassword(${user.user_id}, this)">

            <i class="bi bi-eye"></i>

          </button>

        </div>

      </td>

      <td>${user.full_name || '-'}</td>

      <td>${user.email || '-'}</td>

      <td>${user.role_name}</td>

      <td>

        <span class="badge ${
          user.status === 'active'
            ? 'bg-success'
            : 'bg-secondary'
        }">

          ${user.status}

        </span>

      </td>

      <td>

        <div class="d-flex gap-1">

          <button
            class="btn btn-warning btn-sm"
            onclick="openEditModal(${user.user_id})">

            <i class="bi bi-pencil"></i>

          </button>

          <button
            class="btn btn-danger btn-sm"
            onclick="deleteUser(${user.user_id})">

            <i class="bi bi-trash"></i>

          </button>

        </div>

      </td>

    </tr>

  `).join('');

  document.getElementById('result-count')
    .innerText =
    `ทั้งหมด ${data.length} รายการ`;
}

// TOGGLE PASSWORD
function togglePassword(user_id, btn){

  const passwordEl =
    document.getElementById(`pwd-${user_id}`);

  const icon =
    btn.querySelector('i');

  const user =
    users.find(x => x.user_id == user_id);

  if(!user) return;

  if(passwordEl.dataset.show !== 'true'){

    passwordEl.textContent =
      user.password;

    passwordEl.dataset.show = 'true';

    icon.classList.remove('bi-eye');

    icon.classList.add('bi-eye-slash');

  }else{

    passwordEl.textContent =
      '••••••••';

    passwordEl.dataset.show = 'false';

    icon.classList.remove('bi-eye-slash');

    icon.classList.add('bi-eye');
  }
}

// CHECK USERNAME
usernameInput.addEventListener('input', () => {

  clearTimeout(usernameTimeout);

  const username =
    usernameInput.value.trim();

  usernameError.style.display =
    'none';

  usernameInput.classList.remove(
    'is-invalid',
    'is-valid'
  );

  if(username.length < 3) return;

  usernameTimeout = setTimeout(async () => {

    try{

      const response = await fetch(
        `/check-username?username=${encodeURIComponent(username)}`
      );

      const data =
        await response.json();

      if(data.exists){

        usernameError.style.display =
          'block';

        usernameInput.classList.add(
          'is-invalid'
        );

      }else{

        usernameInput.classList.add(
          'is-valid'
        );
      }

    }catch(err){

      console.error(err);
    }

  },400);
});

// OPEN EDIT
function openEditModal(user_id){

  const user =
    users.find(x => x.user_id == user_id);
  if(!user) return;
  document.getElementById('edit-id').value =
    user.user_id;
  document.getElementById('edit-username').value =
    user.username;
  document.getElementById('edit-password').value =
    user.password;
  document.getElementById('edit-name').value =
    user.full_name || '';
  document.getElementById('edit-email').value =
    user.email || '';
  document.getElementById('edit-role').value =
    user.role;
  document.getElementById('edit-status').value =
    user.status;

  const canvas =
    new bootstrap.Offcanvas(
      document.getElementById('editUserCanvas')
    );

  canvas.show();
}

// ADD USER
document.getElementById('addUserForm')
.addEventListener('submit', async function(e){
  e.preventDefault();
  const form = this;
  if(!form.checkValidity()){
    form.classList.add('was-validated');
    return;
  }
  if(usernameInput.classList.contains('is-invalid')){
    usernameInput.focus();
    return;
  }
  const submitBtn =
    form.querySelector('button[type="submit"]');
  submitBtn.disabled = true;
  submitBtn.innerHTML =
    'กำลังบันทึก...';
  const body = {
    username:
      document.getElementById('add-username').value,
    password:
      document.getElementById('add-password').value,
    name:
      document.getElementById('add-name').value,
    email:
      document.getElementById('add-email').value,
    role:
      document.getElementById('add-role').value,
    status:
      document.getElementById('add-status').value
  };
  try{
    const res =
      await fetch('/api/users',{
        method:'POST',
        headers:{
          'Content-Type':'application/json'
        },
        body:JSON.stringify(body)
      });
    const result =
      await res.json();
    if(!res.ok){
      alert(result.message);
      return;
    }
    bootstrap.Offcanvas
      .getInstance(
        document.getElementById('addUserCanvas')
      )
      .hide();
    form.reset();
    await loadUsers();
  }catch(err){
    console.error(err);
    alert('เกิดข้อผิดพลาด');
  }finally{
    submitBtn.disabled = false;
    submitBtn.innerHTML =
      '<i class="bi bi-save"></i> บันทึก';
  }
});

// UPDATE USER
document.getElementById('editUserForm')
.addEventListener('submit', async function(e){

  e.preventDefault();

  const form = this;

  // VALIDATE
  if (!form.checkValidity()) {

    e.stopPropagation();

    form.classList.add('was-validated');

    return;
  }

  const submitBtn =
    form.querySelector('button[type="submit"]');

  submitBtn.disabled = true;

  submitBtn.innerHTML =
    '<span class="spinner-border spinner-border-sm"></span> กำลังบันทึก...';

  const id =
    document.getElementById('edit-id').value;

  const body = {

    username:
      document.getElementById('edit-username').value.trim(),

    password:
      document.getElementById('edit-password').value.trim(),

    full_name:
      document.getElementById('edit-name').value.trim(),

    email:
      document.getElementById('edit-email').value.trim(),

    role:
      document.getElementById('edit-role').value,

    status:
      document.getElementById('edit-status').value
  };

  try {

    const res = await fetch(`/api/users/${id}`, {

      method: 'PUT',

      headers: {
        'Content-Type': 'application/json'
      },

      body: JSON.stringify(body)
    });

    const result = await res.json();

    if (!res.ok) {

      Swal.fire({

        icon:'error',

        title:'เกิดข้อผิดพลาด',

        text: result.message || 'แก้ไขไม่สำเร็จ'
      });

      return;
    }

    // HIDE OFFCANVAS
    bootstrap.Offcanvas
      .getInstance(
        document.getElementById('editUserCanvas')
      )
      .hide();

    form.classList.remove('was-validated');

    Swal.fire({

      icon:'success',

      title:'สำเร็จ',

      text:'แก้ไขข้อมูลเรียบร้อย',

      timer:1500,

      showConfirmButton:false
    });

    await loadUsers();

  } catch (err) {

    console.error(err);

    Swal.fire({

      icon:'error',

      title:'เกิดข้อผิดพลาด',

      text:'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
    });

  } finally {

    submitBtn.disabled = false;

    submitBtn.innerHTML =
      '<i class="bi bi-save"></i> บันทึกการแก้ไข';
  }
});

// DELETE USER
async function deleteUser(id){
  const result = await Swal.fire({
    title: 'ยืนยันการลบ?',
    text: 'คุณต้องการลบผู้ใช้งานนี้ใช่หรือไม่',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'ลบข้อมูล',
    cancelButtonText: 'ยกเลิก',
    confirmButtonColor: '#dc3545',
    cancelButtonColor: '#6c757d',
    reverseButtons: true
  });
  // CANCEL
  if(!result.isConfirmed) return;
  try{
    // LOADING
    Swal.fire({
      title: 'กำลังลบข้อมูล...',
      allowOutsideClick: false,
      didOpen: () => {
        Swal.showLoading();
      }
    });
    const res = await fetch(`/api/users/${id}`,{
      method:'DELETE'
    });
    const data = await res.json();
    // ERROR
    if(!res.ok){
      Swal.fire({
        icon:'error',
        title:'เกิดข้อผิดพลาด',
        text:data.message || 'ลบข้อมูลไม่สำเร็จ'
      });
      return;
    }
    // SUCCESS
    Swal.fire({
      icon:'success',
      title:'สำเร็จ',
      text:'ลบผู้ใช้งานเรียบร้อย',
      timer:1500,
      showConfirmButton:false
    });
    await loadUsers();
  }catch(err){
    console.error(err);
    Swal.fire({
      icon:'error',
      title:'เกิดข้อผิดพลาด',
      text:'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'
    });
  }
}

// INIT
loadUsers();

</script>

</body>
</html>