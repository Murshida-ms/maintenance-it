<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>แจ้งงาน - ระบบแจ้งงาน</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/sidebar.css">
<link rel="stylesheet" href="/css/form.css">
</head>
<body>

<!-- SIDEBAR -->
<%- include('../partials/sidebar', { page: 'form' }) %>

<!-- MAIN -->
<div class="main">

  <div class="topbar">
    <div>
      <div class="topbar-title">แจ้งงานใหม่</div>
      <div class="breadcrumb-nav">
        <a href="#">Dashboard</a>
        <i class="bi bi-chevron-right" style="font-size:10px"></i>
        <span>แจ้งงาน</span>
      </div>
    </div>
  <!-- ปุ่มแจ้งเตือน -->
  <div style="position:relative" id="noti-wrap">
    <button class="noti-btn" onclick="toggleNotification()" aria-label="การแจ้งเตือน">
      <i class="bi bi-bell"></i>
      <span class="noti-dot" id="noti-dot" style="display:none"></span>
    </button>
    <div class="noti-dropdown" id="noti-dropdown" style="display:none">
      <div class="noti-head">
        <span>การแจ้งเตือน</span>
        <button class="noti-readall" onclick="markAllRead()">อ่านทั้งหมด</button>
      </div>
      <div id="noti-list"></div>
      <div class="noti-foot">
        <button onclick="window.location.href='/timeline'">ดูทั้งหมด</button>
      </div>
    </div>
  </div>
</div>

  <div class="content">

    <!-- TICKET ID BAR -->
    <div class="ticket-bar">
      <div>
        <div class="tk-label">หมายเลข Ticket</div>
        <div class="tk-num" id="ticket-id">-</div>
        <div class="tk-date"><i class="bi bi-calendar3" style="font-size:11px"></i> <span id="tk-date"></span></div>
      </div>
      <div style="text-align:right">
        <div class="tk-status" style="margin-bottom:8px"><span>รอดำเนินการ</span></div>
      </div>
    </div>

    <div class="form-layout">

      <!-- LEFT -->
      <div>

        <!-- ข้อมูลพื้นฐาน -->
        <div class="card-box">
          <div class="card-header">
            <h6>
              <span class="ch-icon" style="background:#EFF6FF;color:#2563EB"><i class="bi bi-info-circle-fill"></i></span>
              ข้อมูลพื้นฐาน
            </h6>
            <span style="font-size:11px;color:var(--text-muted)">กรอกข้อมูลให้ครบก่อนส่ง</span>
          </div>
          <div class="card-body-pad">
            <div class="form-group">
              <label class="form-label">หัวข้อ <span class="req">*</span></label>
              <input type="text" class="form-control" id="task-title" placeholder="เช่น เครื่องปรับอากาศไม่ทำงาน ห้องประชุม A1">
            </div>
            <div class="form-group">
              <label class="form-label">รายละเอียด</label>
              <textarea class="form-control" id="task-detail" rows="4" placeholder="อธิบาย..." oninput="countChars(this, 'char-detail', 500)"></textarea>
              <div class="char-counter" id="char-detail">0 / 500</div>
            </div>
            <div class="form-group">
              <label class="form-label">ผู้แจ้ง</label>
              <div class="input-icon-wrap">
                <i class="bi bi-person"></i>
                <input type="text" class="form-control" id="contact-name" value="" readonly style="background:#F8FAFC;color:var(--text-muted)">
              </div>
            </div>
          </div>
        </div>

        <!-- ความเร่งด่วน -->
        <div class="card-box">
          <div class="card-header">
            <h6>
              <span class="ch-icon" style="background:#FEF2F2;color:#EF4444"><i class="bi bi-exclamation-triangle-fill"></i></span>
              ระดับความเร่งด่วน
            </h6>
          </div>
          <div class="card-body-pad">
            <div class="priority-grid">
              <label class="priority-card low" onclick="selectPriority(this,'low')">
                <input type="radio" name="priority" value="low">
                <span class="pc-icon">🟢</span>
                <div class="pc-label" style="color:#059669">ปกติ</div>
                <div class="pc-sub">SLA ภายใน 3 วัน</div>
              </label>
              <label class="priority-card med" onclick="selectPriority(this,'med')">
                <input type="radio" name="priority" value="med">
                <span class="pc-icon">🟡</span>
                <div class="pc-label" style="color:#D97706">ปานกลาง</div>
                <div class="pc-sub">SLA ภายใน 1 วัน</div>
              </label>
              <label class="priority-card high" onclick="selectPriority(this,'high')">
                <input type="radio" name="priority" value="high">
                <span class="pc-icon">🔴</span>
                <div class="pc-label" style="color:#DC2626">ด่วน</div>
                <div class="pc-sub">SLA ภายใน 4 ชม.</div>
              </label>
            </div>

            <!-- SLA BLOCK -->
            <div id="sla-block" class="sla-block" style="display:none">
              <div class="sla-header">
                <span><i class="bi bi-clock-history" style="margin-right:5px"></i>กำหนด SLA</span>
                <span class="sla-badge" id="sla-badge-label">—</span>
              </div>
              <div class="sla-body">
                <div class="sla-deadline-col">
                  <div class="sla-dl-label">📅 Deadline</div>
                  <div class="sla-dl-time" id="sla-dl-time">—</div>
                  <div class="sla-dl-date" id="sla-dl-date">—</div>
                </div>
              </div>
            </div>

            <div style="margin-top:16px">
              <label class="form-label">หมายเหตุเพิ่มเติม <span class="hint">(ถ้ามี)</span></label>
              <textarea class="form-control" id="priority-note" rows="2" placeholder="ข้อมูลเพิ่มเติม..." oninput="countChars(this,'char-pnote',200)"></textarea>
              <div class="char-counter" id="char-pnote">0 / 200</div>
            </div>
          </div>
        </div>

        <!-- แนบรูป -->
        <div class="card-box">
          <div class="card-header">
            <h6>
              <span class="ch-icon" style="background:#F0FDF4;color:#16A34A"><i class="bi bi-images"></i></span>
              แนบรูปภาพ / เอกสาร <span class="hint" style="font-size:11px;font-weight:400;color:var(--text-muted)">(ไม่เกิน 5 ไฟล์, สูงสุดไฟล์ละ 10MB)</span>
            </h6>
          </div>
          <div class="card-body-pad">
            <div class="file-drop" id="file-drop" onclick="document.getElementById('file-input').click()" ondragover="dragOver(event)" ondragleave="dragLeave(event)" ondrop="dropFile(event)">
              <input type="file" id="file-input" name="files" accept="image/*,.pdf" multiple onchange="handleFiles(this.files)">
              <div class="fd-icon"><i class="bi bi-cloud-arrow-up"></i></div>
              <div class="fd-title">คลิกหรือลากไฟล์มาวางที่นี่</div>
              <div class="fd-sub">รองรับ JPG, PNG, PDF · สูงสุด 10MB ต่อไฟล์</div>
            </div>
            <div class="file-preview" id="file-preview"></div>
          </div>
        </div>

      </div>

      <!-- RIGHT -->
      <div>
        <div class="card-box">
          <div class="card-header">
            <h6>
              <span class="ch-icon" style="background:#F1F5F9;color:#64748B"><i class="bi bi-clock-history"></i></span>
              รายการล่าสุด
            </h6>
            <span style="font-size:11px;color:var(--text-muted)" id="recent-count">—</span>
          </div>
          <div class="card-body-pad" id="recent-list">
            <div class="recent-empty">
              <i class="bi bi-inbox"></i>
              ยังไม่มีรายการ
            </div>
          </div>
          <div class="recent-footer">
            <a href="/history"><i class="bi bi-arrow-right-circle"></i> ดูประวัติทั้งหมด</a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SUBMIT AREA -->
  <div class="submit-area">
    <button class="btn-cancel" onclick="if(confirm('ยกเลิกและล้างข้อมูลทั้งหมด?')){ resetForm(); }">
      <i class="bi bi-x-lg"></i> ยกเลิก
    </button>
    <div style="display:flex;align-items:center;gap:16px">
      <div id="validate-msg" style="font-size:12px;color:var(--rejected);display:none"><i class="bi bi-exclamation-circle"></i></div>
      <button class="btn-primary-lg" onclick="submitForm()">
        <i class="bi bi-send-fill"></i> ส่งงาน
      </button>
    </div>
  </div>

</div>

<!-- SUCCESS MODAL -->
<div class="modal-overlay" id="success-modal">
  <div class="modal-box">
    <div style="display:flex;justify-content:flex-end;margin-bottom:8px">
      <button onclick="closeModal()" style="background:transparent;border:none;cursor:pointer;color:var(--text-muted);font-size:20px;line-height:1">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div class="modal-icon"><i class="bi bi-check-lg"></i></div>
    <h5>ส่งงานสำเร็จ! 🎉</h5>
    <div class="modal-ticket" id="modal-ticket-num">TK-0249</div>
    <div id="modal-sla-info" style="display:none;background:#F8FAFC;border-radius:8px;padding:10px 16px;margin-bottom:16px;font-size:13px;text-align:left">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
        <i class="bi bi-clock" style="color:var(--primary)"></i>
        <span style="font-weight:600;color:var(--text-main)">กำหนด SLA</span>
        <span id="modal-sla-badge" class="sla-summary-badge"></span>
      </div>
      <div style="color:var(--text-muted)">ต้องเสร็จภายใน: <strong id="modal-sla-deadline" style="color:var(--text-main)">—</strong></div>
    </div>
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:24px">กด "ติดตามงาน" เพื่อดูความคืบหน้า</div>
    <div class="modal-actions">
      <button class="btn-mod-track" onclick="goToTrackPage()"><i class="bi bi-eye"></i> ติดตามงาน</button>
      <button class="btn-mod-new" onclick="resetForm()"><i class="bi bi-plus-lg"></i> แจ้งงานใหม่</button>
    </div>
  </div>
</div>
<script src="/js/form.js"></script>

</body>
</html>