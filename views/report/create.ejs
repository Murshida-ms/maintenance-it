<div class="card">

    <div class="card-header">
        <h5>สร้าง Template รายงาน</h5>
    </div>

    <div class="card-body">

        <form action="/report/create" method="POST">

            <div class="mb-3">
                <label class="form-label">
                    ชื่อรายงาน
                </label>

                <input type="text"
                       name="report_name"
                       class="form-control"
                       required>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    รายละเอียด
                </label>

                <textarea name="report_description"
                          rows="3"
                          class="form-control"></textarea>
            </div>

            <button class="btn btn-primary">
                สร้างรายงาน
            </button>

        </form>

    </div>

</div>