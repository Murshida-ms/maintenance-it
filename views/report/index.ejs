<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ระบบแจ้งงาน - Report</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/css/history.css">

</head>

<body>

<%- include('../layout/sidebar') %>

<!-- MAIN -->
<div class="main">

    <!-- TOPBAR -->
    <div class="topbar">

        <div>

            <div class="topbar-title">
                รายงาน
            </div>

            <div class="topbar-sub">
                รายงานทั้งหมด
            </div>

        </div>

        <div class="topbar-actions">

            <!-- CREATE BUTTON -->
            <button class="btn-ghost-sm"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#createReportCanvas">

                <i class="bi bi-file-text"></i>

                สร้างรายงาน

            </button>

            <button class="icon-btn"
                    title="แจ้งเตือน">

                <i class="bi bi-bell"
                   style="font-size:16px"></i>
                <span class="notif-dot"></span>

            </button>

        </div>

    </div>

    <!-- CONTENT -->
    <div class="content">
        <!-- TABLE -->
        <div class="card-box">
            <div class="card-header">
                <h6>
                    <i class="bi bi-file-earmark-bar-graph"
                       style="color:var(--primary);margin-right:6px"></i>
                    รายการ Template Report
                </h6>
            </div>

            <div style="overflow-x:auto">

                <table class="history-table">

                    <thead>

                        <tr>

                            <th width="80">#</th>

                            <th>ชื่อรายงาน</th>

                            <th>รายละเอียด</th>

                            <th width="180">วันที่สร้าง</th>

                            <th width="250">จัดการ</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% reports.forEach((item,index)=> { %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>

                                    <strong>
                                        <%= item.report_name %>
                                    </strong>

                                </td>

                                <td>

                                    <%= item.report_description || '-' %>

                                </td>

                                <td>

                                    <%= item.created_at %>

                                </td>

                                <td>

                                    <!-- DESIGN -->
                                    <a href="/report/designer/<%= item.report_id %>"
                                       class="btn btn-primary btn-sm">

                                        <i class="bi bi-palette"></i>

                                        Design

                                    </a>

                                    <!-- EDIT -->
                                    <button class="btn btn-warning btn-sm"

                                            data-item='<%- JSON.stringify(item) %>'

                                            onclick="openEditModal(this)">

                                        <i class="bi bi-pencil-square"></i>

                                        Edit

                                    </button>

                                    <!-- DELETE -->
                                    <button class="btn btn-danger btn-sm"
        data-id="<%= item.report_id %>"
        onclick="deleteReport(this)">

    <i class="bi bi-trash"></i>

    Delete

</button>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- ========================= -->
<!-- CREATE OFFCANVAS -->
<!-- ========================= -->

<div class="offcanvas offcanvas-end"

     tabindex="-1"

     id="createReportCanvas"

     style="width:450px;">

    <div class="offcanvas-header border-bottom">

        <div>

            <h5 class="offcanvas-title">
                สร้างรายงาน
            </h5>

            <small class="text-muted">
                สร้าง Template รายงานใหม่
            </small>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>

    <div class="offcanvas-body">

        <form action="/report/create"
            method="POST">

          <div class="mb-3">

              <label class="form-label">
                  ชื่อรายงาน
              </label>

              <input type="text"
                    name="report_name"
                    class="form-control"
                    required>

          </div>

          <div class="mb-3">

              <label class="form-label">
                  รายละเอียด
              </label>

              <textarea name="report_description"
                        rows="3"
                        class="form-control"></textarea>

          </div>

          <div class="mb-3">

              <label class="form-label">
                  SQL Report
              </label>

              <textarea name="report_sql"
                        rows="12"
                        class="form-control font-monospace"
                        placeholder="SELECT * FROM vn_stat"></textarea>

          </div>

          <button class="btn btn-primary w-100">

              <i class="bi bi-save"></i>

              บันทึกรายงาน

          </button>

      </form>

    </div>

</div>

<!-- ========================= -->
<!-- EDIT OFFCANVAS -->
<!-- ========================= -->

<div class="offcanvas offcanvas-end"

     tabindex="-1"

     id="editCanvas"

     style="width:450px;">

    <div class="offcanvas-header border-bottom">

        <div>

            <h5 class="offcanvas-title">
                แก้ไขรายงาน
            </h5>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>

    <div class="offcanvas-body">

        <form id="editForm"
              method="POST">

            <div class="mb-3">

                <label class="form-label">
                    ชื่อรายงาน
                </label>

                <input type="text"
                       id="edit_report_name"
                       name="report_name"
                       class="form-control"
                       required>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    รายละเอียด
                </label>

                <textarea id="edit_report_description"
                          name="report_description"
                          rows="3"
                          class="form-control"></textarea>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    SQL Report
                </label>

                <textarea id="edit_report_sql"
                          name="report_sql"
                          rows="12"
                          class="form-control font-monospace"></textarea>

            </div>

            <button class="btn btn-warning w-100">

                <i class="bi bi-pencil-square"></i>

                บันทึกการแก้ไข

            </button>

        </form>

    </div>

</div>

<!-- ========================= -->
<!-- JS -->
<!-- ========================= -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

async function loadUser() {

    try {

        const res = await fetch('/api/me');

        if (res.status === 401) {

            window.location.href = '/login';

            return;
        }

        const data = await res.json();

        const fullname =
            document.getElementById('user-fullname');

        const role =
            document.getElementById('user-role');

        const avatar =
            document.getElementById('user-avatar');

        if(fullname) {
            fullname.textContent = data.fullName;
        }

        if(role) {
            role.textContent = data.role;
        }

        if(avatar) {
            avatar.textContent =
                data.fullName.substring(0, 2);
        }

    } catch (e) {

        console.error(e);

    }
}

loadUser();

function openEditModal(button) {

    const item = JSON.parse(
        button.dataset.item
    );

    document.getElementById('edit_report_name').value =
        item.report_name;

    document.getElementById('edit_report_description').value =
        item.report_description || '';

    document.getElementById('editForm').action =
        '/report/update/' + item.report_id;

    const canvas = new bootstrap.Offcanvas(
        document.getElementById('editCanvas')
    );

    canvas.show();
}

async function deleteReport(button) {

    const id = button.dataset.id;

    const confirm = await Swal.fire({

        title: 'ยืนยันการลบ?',

        text: 'ลบแล้วไม่สามารถย้อนกลับได้',

        icon: 'warning',

        showCancelButton: true,

        confirmButtonText: 'ลบ',

        cancelButtonText: 'ยกเลิก'

    });

    if (!confirm.isConfirmed) return;

    try {

        const res = await fetch('/report/delete/' + id, {

            method: 'POST'

        });

        const data = await res.json();

        if (data.success) {

            Swal.fire({

                icon: 'success',

                title: 'ลบสำเร็จ',

                timer: 1200,

                showConfirmButton: false

            });

            setTimeout(() => {

                location.reload();

            }, 1200);

        }

    } catch (err) {

        console.error(err);

        Swal.fire({

            icon: 'error',

            title: 'เกิดข้อผิดพลาด'

        });

    }
}

</script>

</body>
</html>