<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= report.report_name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            font-family: "Sarabun", sans-serif;
        }

        body {
            margin: 24px;
            color: #111827;
            font-size: 13px;
        }

        .toolbar {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 16px;
        }

        .toolbar button {
            border: 1px solid #cbd5e1;
            background: #fff;
            border-radius: 6px;
            padding: 7px 12px;
            cursor: pointer;
        }

        .report-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .report-subtitle,
        .report-date {
            color: #64748b;
            margin-bottom: 4px;
        }

        .template-text {
            white-space: pre-wrap;
            margin: 18px 0;
            line-height: 1.6;
        }

        .filter-box {
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            border-radius: 8px;
            padding: 10px 12px;
            margin: 16px 0;
        }

        .filter-item {
            display: inline-flex;
            gap: 6px;
            margin-right: 18px;
            margin-bottom: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 14px;
        }

        th,
        td {
            border: 1px solid #cbd5e1;
            padding: 7px 8px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #e2e8f0;
            font-weight: 700;
        }

        tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        .footer {
            margin-top: 18px;
            color: #64748b;
            text-align: right;
        }

        .no-data {
            border: 1px dashed #cbd5e1;
            color: #64748b;
            padding: 32px;
            text-align: center;
            margin-top: 18px;
        }

        @media print {
            body {
                margin: 10mm;
            }

            .toolbar {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button onclick="window.print()">Print</button>
        <button onclick="window.close()">Close</button>
    </div>

    <!--
    <div class="report-title"><%= report.report_name %></div>
    <% if (report.report_description) { %>
        <div class="report-subtitle"><%= report.report_description %></div>
    <% } %>
    <div class="report-date">Generated: <%= generatedAt %></div>
    -->
    <% if (header) { %>
        <div class="template-text text-bold"><%= header %></div>
    <% } %>

    <!--
    <% if (filters && Object.keys(filters).length > 0) { %>
        <div class="filter-box">
            <% Object.keys(filters).forEach(key => { %>
                <div class="filter-item">
                    <strong><%= key %>:</strong>
                    <span><%= filters[key] || '-' %></span>
                </div>
            <% }) %>
        </div>
    <% } %>
    -->

    <% if (rows && rows.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <% columns.forEach(col => { %>
                        <th><%= col.label %></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% rows.forEach(row => { %>
                    <tr>
                        <% columns.forEach(col => { %>
                            <td><%= row[col.field] ?? '-' %></td>
                        <% }) %>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <div class="footer">Total <strong><%= rows.length %></strong> records</div>
    <% } else { %>
        <div class="no-data">No data</div>
    <% } %>

    <% if (footer) { %>
        <div class="template-text"><%= footer %></div>
    <% } %>

    <script>
        window.addEventListener('load', () => {
            setTimeout(() => window.print(), 300);
        });
    </script>
</body>
</html>
