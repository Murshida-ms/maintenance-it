<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskFlow Pro — เข้าสู่ระบบ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  <link rel="stylesheet" href="css/login.css">
</head>
<body>

<div class="page">
  <div class="left">
    <div class="left-icon-ring"><i class="ti ti-layout-kanban"></i></div>
    <div class="left-name">TaskFlow Pro</div>
    <div class="left-desc">ระบบจัดการงานและมอบหมายงาน<br>สำหรับทีมและองค์กร</div>
    <div class="left-divider"></div>
  </div>

  <div class="right">
    <div class="tabs">
      <div class="tab active" id="tab-user" onclick="switchTab('user')"><i class="ti ti-user"></i> ผู้แจ้งงาน</div>
      <div class="tab" id="tab-staff" onclick="switchTab('staff')"><i class="ti ti-shield-check"></i> เจ้าหน้าที่</div>
    </div>

    <div class="forms">
      <div class="form-panel" id="form-user">
        <div class="form-head">
          <h2>ยินดีต้อนรับกลับมา!</h2>
          <p>กรุณาเข้าสู่ระบบเพื่อดำเนินการต่อ</p>
        </div>
        
        <form action="/login" method="POST" class="needs-validation" novalidate>
          <div class="field">
            <label>ชื่อผู้ใช้งาน (Username)</label>
            <div class="field-wrap"><i class="ti ti-user"></i>
              <input type="text" name="username" placeholder="กรอกชื่อผู้ใช้งาน..." required>
            </div>
            <div class="invalid-feedback">กรุณากรอกชื่อผู้ใช้งาน</div>
          </div>

          <div class="field">
            <label>รหัสผ่าน (Password)</label>
            <div class="field-wrap"><i class="ti ti-lock"></i>
              <input type="password" name="password" placeholder="กรอกรหัสผ่าน..." required>
            </div>
            <div class="invalid-feedback">กรุณากรอกรหัสผ่าน</div>
          </div>

          <div class="row-opts">
            <label class="check-row"><input type="checkbox"> จดจำฉันไว้</label>
            <a href="#" class="forgot" style="font-size: 12px; color: #7B2FF7; text-decoration: none;">ลืมรหัสผ่าน?</a>
          </div>
          <button type="submit" class="btn-login btn-u">เข้าสู่ระบบ <i class="ti ti-arrow-right"></i></button>
        </form>
        <div class="register-row">
          บุคลากรใหม่หรือไม่? &nbsp; <a href="/register"><i class="ti ti-user-plus"></i> ลงทะเบียนใช้งาน</a>
        </div>
      </div>

      <div class="form-panel hidden" id="form-staff">
        <div class="form-head">
          <!-- <div class="staff-pill"><i class="ti ti-shield-check"></i> Staff Portal</div> -->
          <h2>เข้าสู่ระบบเจ้าหน้าที่</h2>
          <p>สำหรับทีมงานที่รับผิดชอบดำเนินงาน</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>
    <div class="field">
      <label>ชื่อผู้ใช้งานเจ้าหน้าที่</label>
      <div class="field-wrap"><i class="ti ti-user"></i>
        <input type="text" name="username" placeholder="กรอกชื่อผู้ใช้งาน..." required>
      </div>
      <!-- <div id="login-error-staff" class="error-msg"><i class="ti ti-alert-circle"></i> ชื่อผู้ใช้หรือรหัสผ่านเจ้าหน้าที่ไม่ถูกต้อง</div> -->
      <div class="invalid-feedback">กรุณากรอกชื่อผู้ใช้งาน</div>
    </div>

          <div class="field">
            <label>รหัสผ่าน</label>
            <div class="field-wrap"><i class="ti ti-lock"></i>
              <input type="password" name="password" placeholder="กรอกรหัสผ่าน..." required>
            </div>
            <div class="invalid-feedback">กรุณากรอกรหัสผ่าน</div>
          </div>
          <button type="submit" class="btn-login btn-s">
            <i class="ti ti-shield-check"></i> เข้าสู่ระบบเจ้าหน้าที่</button>
        </form>

        <div class="staff-note">
          <i class="ti ti-info-circle" style="color: #16A34A;"></i>
          <p>บัญชีเจ้าหน้าที่จัดการโดยผู้ดูแลระบบเท่านั้น</p>
        </div>
      </div>
    </div>
    <div class="copy">© 2026 TaskFlow Pro Systems.</div>
  </div>
</div>

<script>
  function switchTab(t, noAnim = false) {
    const tabUser = document.getElementById('tab-user');
    const tabStaff = document.getElementById('tab-staff');
    const formUser = document.getElementById('form-user');
    const formStaff = document.getElementById('form-staff');

    if (noAnim) {
      formUser.classList.add('no-transition');
      formStaff.classList.add('no-transition');
    }

    tabUser.classList.toggle('active', t === 'user');
    tabStaff.classList.toggle('active', t === 'staff');
    formUser.classList.toggle('hidden', t !== 'user');
    formStaff.classList.toggle('hidden', t !== 'staff');

    // --- เปลี่ยนมาใช้ sessionStorage เพื่อให้ล้างค่าเมื่อปิดเว็บ ---
    sessionStorage.setItem('activeTab', t);

    if (noAnim) {
      setTimeout(() => {
        formUser.classList.remove('no-transition');
        formStaff.classList.remove('no-transition');
      }, 50);
    }
  }

  window.addEventListener('load', () => {
    // ดึงค่าจาก sessionStorage (ถ้าไม่มีค่าเลย หรือเปิดใหม่ จะได้ 'user' เป็นค่าเริ่มต้น)
    const savedTab = sessionStorage.getItem('activeTab') || 'user';
    switchTab(savedTab, true); 

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('error') === 'failed') {
      const errorId = (savedTab === 'user') ? 'login-error' : 'login-error-staff';
      const errorDiv = document.getElementById(errorId);
      
      if (errorDiv) {
        errorDiv.style.display = 'flex';
        const activePanelId = (savedTab === 'user') ? 'form-user' : 'form-staff';
        document.querySelectorAll(`#${activePanelId} input`).forEach(input => {
          input.style.borderColor = '#ef4444';
        });
      }

      const cleanUrl = window.location.origin + window.location.pathname;
      window.history.replaceState(null, '', cleanUrl);
    }
  });
</script>
<script>
(() => {
  'use strict';

  const forms = document.querySelectorAll('.needs-validation');

  Array.from(forms).forEach(form => {

    form.addEventListener('submit', event => {

      if (!form.checkValidity()) {

        event.preventDefault();
        event.stopPropagation();

        form.classList.add('was-validated');

        return;
      }

      const btn = form.querySelector('button[type="submit"]');

      if (btn) {
        btn.disabled = true;

        btn.innerHTML =
          '<i class="ti ti-loader-2 ti-spin"></i> กำลังเข้าสู่ระบบ...';
      }

    }, false);

  });

})();
</script>
</body>
</html>