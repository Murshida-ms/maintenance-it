<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบแจ้งงาน - Report Builder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/history.css">
    <style>
        body{
            background:#f5f7fb;
        }
        .sql-box{
            min-height:300px;
            font-family:
                Consolas,
                monospace;
        }
        .template-box{
            min-height:400px;
            font-family:
                Consolas,
                monospace;
        }

        .preview-box{
            min-height:600px;
            background:#fff;
            border:1px solid #dee2e6;
            padding:20px;
            overflow:auto;
        }
        a {
            text-decoration: none;
            color: blue; /* Optional: set link color */
        }

    </style>
</head>

<body>
<%- include('../layout/sidebar') %>
<div class="main">

    <div class="topbar">

        <div>
            <div class="topbar-title">
                Report Builder
            </div>

            <div class="topbar-sub">
                จัดการ Template รายงาน
            </div>
        </div>

        <div class="topbar-actions">
            <a
                href="/report2"
                class="btn-ghost-sm">
                <i class="bi bi-arrow-left-circle"></i>
                กลับ

            </a>

        </div>

    </div>

    <div class="row">

        <div class="col-lg-12">
            <div class="card">
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <button
                            class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#paramTab">
                            Parameters
                        </button>
                    </li>
                    <li class="nav-item">
                        <button
                            class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#sqlTab">
                            SQL
                        </button>
                    </li>
                    <li class="nav-item">
    
                        <button
                            class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#templateTab">
    
                            Template
    
                        </button>
    
                    </li>
                </ul>
                <div class="tab-content">
                    <!-- SQL -->
                    <div class="tab-pane fade p-3" id="sqlTab">
                        <button
                            class="btn btn-primary mb-2"
                            onclick="testSQL()">
                            Run SQL
                        </button>
                        <textarea
                            id="report_sql"
                            class="form-control"
                            style="height:70vh"><%= report.report_sql || '' %></textarea>

                        <div id="sqlResult" class="mt-3"></div>
    
                    </div>
                    <!-- TEMPLATE -->
                    <div class="tab-pane fade p-3"
                        id="templateTab">
    
                        <button
                            class="btn btn-success mb-2"
                            onclick="saveReport()">
                            Save
                        </button>
                        <textarea
                            id="report_template"
                            class="form-control"
                            style="height:70vh"><%= report.report_template || '' %></textarea>
                    </div>
                    <!--  PARAM -->
                    <div class="tab-pane fade show active  p-3" id="paramTab">
                        <button
                            class="btn btn-primary mb-2"
                            onclick="addParam()">
    
                            เพิ่มตัวแปร
    
                        </button>
    
                        <div id="paramArea"></div>
    
                    </div>
    
                </div>
            </div>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const Toast =
    Swal.mixin({

        toast:true,

        position:'top-end',

        showConfirmButton:false,

        timer:2000,

        timerProgressBar:true

    });
</script>
<script>

async function testSQL(){

    const sql =
        document.getElementById(
            'report_sql'
        ).value;

    const response =
        await fetch(
            '/report2/test-sql',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({
                        sql
                    })
            }
        );

    const result =
        await response.json();

    document.getElementById(
        'sqlResult'
    ).innerHTML =
        '<pre>'+
        JSON.stringify(
            result,
            null,
            2
        )+
        '</pre>';

}

async function previewReport(){

    const response =
        await fetch(
            '/report2/preview/<%= report.report_id %>',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({

                        report_sql:
                            document.getElementById(
                                'report_sql'
                            ).value,

                        report_template:
                            document.getElementById(
                                'report_template'
                            ).value

                    })
            }
        );

    const result =
        await response.json();

    if(result.success){

        document.getElementById(
            'previewArea'
        ).innerHTML =
            result.html;

    }
    else{

        alert(
            result.message
        );

    }

}

async function saveReport(){

    const response =
        await fetch(
            '/report2/save/<%= report.report_id %>',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({

                        report_sql:
                            document.getElementById(
                                'report_sql'
                            ).value,

                        report_template:
                            document.getElementById(
                                'report_template'
                            ).value

                    })

            }
        );

    const result =
        await response.json();

    if(result.success){

        Toast.fire({

            icon:'success',

            title:'บันทึกสำเร็จ'

        });

    }

}

</script>

<script>

let reportParams =
<%- report.report_params || '[]' %>;

renderParams();

function renderParams(){

    let html = '<div class="row g-2">';

    reportParams.forEach((p,index)=>{

        html += `

        <div class="col-md-3">

            <div class="card h-100">

                <div class="card-body">

                    <input
                        class="form-control mb-2"
                        placeholder="name"
                        value="${p.name || ''}"

                        onchange="
                        reportParams[${index}].name=this.value">

                    <input
                        class="form-control mb-2"
                        placeholder="label"
                        value="${p.label || ''}"

                        onchange="
                        reportParams[${index}].label=this.value">

                    <select
                        class="form-select"

                        onchange="
                        reportParams[${index}].type=this.value">

                        <option
                            value="text"
                            ${p.type=='text' ? 'selected' : ''}>

                            Text

                        </option>

                        <option
                            value="date"
                            ${p.type=='date' ? 'selected' : ''}>

                            Date

                        </option>

                    </select>

                </div>

            </div>

        </div>

        `;

    });

    html += '</div>';

    document
        .getElementById('paramArea')
        .innerHTML = html;

}

function addParam(){

    reportParams.push({

        name:'',
        label:'',
        type:'text'

    });

    renderParams();

}

async function testSQL(){

    const response =
        await fetch(
            '/report2/test-sql',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                    'application/json'
                },

                body:JSON.stringify({

                    sql:
                    document
                    .getElementById(
                        'report_sql'
                    )
                    .value

                })

            }
        );

    const result =
        await response.json();

    document
    .getElementById(
        'sqlResult'
    )
    .innerHTML=
    '<pre>'+
    JSON.stringify(
        result,
        null,
        2
    )+
    '</pre>';

}

async function saveReport(){

    const response =
        await fetch(
            '/report2/save/<%= report.report_id %>',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                    'application/json'
                },

                body:
                JSON.stringify({

                    report_sql:
                    document
                    .getElementById(
                        'report_sql'
                    )
                    .value,

                    report_template:
                    document
                    .getElementById(
                        'report_template'
                    )
                    .value,

                    report_params:
                    reportParams

                })

            }
        );

    const result =
        await response.json();

    if(result.success){

        Toast.fire({
            icon:'success',
            title:'บันทึกสำเร็จ'
        });

    }

}

</script>

</body>
</html>