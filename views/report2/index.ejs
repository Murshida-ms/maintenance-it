<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบแจ้งงาน - Report Builder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/history.css">
</head>

<body>

<%- include('../layout/sidebar') %>

<div class="main">

    <div class="topbar">

        <div>
            <div class="topbar-title">
                Report Builder
            </div>

            <div class="topbar-sub">
                จัดการ Template รายงาน
            </div>
        </div>

        <div class="topbar-actions">

            <button
                class="btn btn-sm btn-primary"
                data-bs-toggle="offcanvas"
                data-bs-target="#createReportCanvas">

                <i class="bi bi-plus-circle"></i>
                สร้างรายงาน

            </button>

        </div>

    </div>

    <div class="content">

        <div class="card-box">

            <div class="card-header">

                <h6>

                    <i class="bi bi-file-earmark-bar-graph"
                       style="color:var(--primary);margin-right:6px"></i>

                    รายการ Report Template

                </h6>

            </div>

            <div style="overflow-x:auto">

                <table class="history-table">

                    <thead>

                        <tr>

                            <th width="80">#</th>

                            <th>ชื่อรายงาน</th>

                            <th>รายละเอียด</th>

                            <th width="180">วันที่สร้าง</th>

                            <th width="320">จัดการ</th>

                        </tr>

                    </thead>

                    <tbody>

                        <% if(reports.length === 0){ %>

                            <tr>

                                <td colspan="5"
                                    class="text-center">

                                    ยังไม่มีรายงาน

                                </td>

                            </tr>

                        <% } %>

                        <% reports.forEach((item,index)=>{ %>

                            <tr>

                                <td>
                                    <%= index + 1 %>
                                </td>

                                <td>

                                    <strong>
                                        <%= item.report_name %>
                                    </strong>

                                </td>

                                <td>

                                    <%= item.report_description || '-' %>

                                </td>

                                <td>

                                    <%= formatDateTime(item.created_at) %>

                                </td>

                                <td>

                                    <button
                                        class="btn btn-success btn-sm"
                                        onclick="openPrintModal(<%= item.report_id %>)">

                                        <i class="bi bi-printer"></i>

                                        Print

                                    </button>

                                    <a
                                        href="/report2/setting/<%= item.report_id %>"
                                        class="btn btn-primary btn-sm">

                                        <i class="bi bi-gear"></i>

                                        Setting

                                    </a>

                                    <button
                                        class="btn btn-danger btn-sm"
                                        onclick="deleteReport(<%= item.report_id %>)">

                                        <i class="bi bi-trash"></i>

                                        Delete

                                    </button>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- CREATE REPORT -->

<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="createReportCanvas">

    <div class="offcanvas-header">

        <h5>

            สร้างรายงานใหม่

        </h5>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"></button>

    </div>

    <div class="offcanvas-body">

        <form
            action="/report2/create"
            method="POST">

            <div class="mb-3">

                <label class="form-label">

                    ชื่อรายงาน

                </label>

                <input
                    type="text"
                    name="report_name"
                    class="form-control"
                    required>

            </div>

            <div class="mb-3">

                <label class="form-label">

                    รายละเอียด

                </label>

                <textarea
                    name="report_description"
                    rows="4"
                    class="form-control"></textarea>

            </div>

            <button
                type="submit"
                class="btn btn-primary">

                <i class="bi bi-save"></i>

                บันทึก

            </button>

        </form>

    </div>

</div>

<!-- PRINT MODAL -->

<div class="modal fade"
     id="printModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>

                    พิมพ์รายงาน

                </h5>

            </div>

            <div class="modal-body">

                <input
                    type="hidden"
                    id="report_id">

                <div class="mb-3">

                    <label>

                        วันที่เริ่มต้น

                    </label>

                    <input
                        type="date"
                        id="date_start"
                        class="form-control">

                </div>

                <div class="mb-3">

                    <label>

                        วันที่สิ้นสุด

                    </label>

                    <input
                        type="date"
                        id="date_end"
                        class="form-control">

                </div>

            </div>

            <div class="modal-footer">

                <button
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                    ปิด

                </button>

                <button
                    class="btn btn-success"
                    onclick="runReport()">

                    พิมพ์รายงาน

                </button>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

function openPrintModal(id){

    document.getElementById('report_id').value = id;

    const modal =
        new bootstrap.Modal(
            document.getElementById('printModal')
        );

    modal.show();
}

function runReport(){

    const id =
        document.getElementById('report_id').value;

    const start =
        document.getElementById('date_start').value;

    const end =
        document.getElementById('date_end').value;

    window.open(
        `/report2/run/${id}?date_start=${start}&date_end=${end}`,
        '_blank'
    );
}

function openEditModal(btn){

    const item =
        JSON.parse(
            btn.dataset.item
        );

    console.log(item);

    // ต่อไปค่อยเปิด offcanvas edit
}

async function deleteReport(id){

    const result = await Swal.fire({
            title: 'ยืนยันการลบ ID ' + id + ' ?',
            text: 'ลบแล้วไม่สามารถย้อนกลับได้',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'ลบ',
            cancelButtonText: 'ยกเลิก'
        });

    if(!result.isConfirmed)return;

    try {
                const res = await fetch('/report2/delete/' + id, {
                    method: 'POST'
                });
                const data = await res.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'ลบสำเร็จ',
                        timer: 1200,
                        showConfirmButton: false
                    });

                    setTimeout(() => {
                        location.reload();
                    }, 1200);

                }

            } catch (err) {

                console.error(err);

                Swal.fire({

                    icon: 'error',

                    title: 'เกิดข้อผิดพลาด'

                });

            }
}

</script>

</body>
</html>